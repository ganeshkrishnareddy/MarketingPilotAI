# ═══════════════════════════════════════════════════════════
# V360 AI Agency — Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ─── App URLs ─────────────────────────────────────────────
NEXT_PUBLIC_PB_URL=http://pocketbase:8090
NEXT_PUBLIC_APP_URL=https://vision360aisolutions.in
NEXT_PUBLIC_APP_NAME=V360 AI Agency
N8N_HOST=n8n.localhost
WEBHOOK_URL=https://n8n.localhost

# ─── AI Providers (server-side only) ──────────────────────
# OpenRouter (free models)
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-xxxx
AI_MODEL=openrouter/free

# OpenCode (free models)
OPENCODE_API_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=mimo-v2.5-free

# ─── Voice AI ─────────────────────────────────────────────
DEEPGRAM_API_KEY=
GROQ_API_KEY=
RUMIK_API_KEY=

# ─── WhatsApp Business ────────────────────────────────────
WHATSAPP_TEMPLATE_NAME=hello_world

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ─── PocketBase Admin ─────────────────────────────────────
POCKETBASE_ADMIN_EMAIL=admin@vision360.ai
POCKETBASE_ADMIN_PASSWORD=Vision@360
